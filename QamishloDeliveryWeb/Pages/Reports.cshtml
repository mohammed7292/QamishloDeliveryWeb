@page
@model QamishloDeliveryWeb.Pages.ReportsModel
@{
    Layout = null;
    ViewData["Title"] = "Delivery Reports";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111111" />
    <link rel="manifest" href="/manifest.json" />
    <title>Delivery Reports - Qamishlo</title>

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 18px 12px 35px;
            background: #101010;
            color: white;
            font-family: Arial, Helvetica, sans-serif;
        }

        .container { max-width: 720px; margin: auto; }

        .header {
            padding: 23px;
            margin-bottom: 20px;
            border-radius: 22px;
            color: #211609;
            background: linear-gradient(120deg, #f28b12, #ffd329);
        }

        .brand { font-size: 19px; font-weight: 900; }
        .subtitle { margin-top: 8px; font-size: 13px; }

        .back {
            display: inline-block;
            margin-top: 18px;
            color: #211609;
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
        }

        h2 { margin: 23px 2px 13px; font-size: 21px; }

        .stats {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 11px;
        }

        .card, .order, .notice {
            min-width: 0;
            padding: 17px;
            border: 1px solid #373737;
            border-radius: 17px;
            background: linear-gradient(145deg, #252525, #191919);
        }

        .label { color: #aaa; font-size: 12px; line-height: 1.5; }
        .value {
            margin-top: 8px;
            color: #ffd329;
            font-size: clamp(21px, 5vw, 28px);
            font-weight: 900;
            overflow-wrap: anywhere;
        }

        .order { margin-bottom: 12px; }

        .order-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
        }

        .order-id { font-size: 18px; font-weight: 900; }

        .badge {
            padding: 7px 10px;
            border-radius: 20px;
            background: #17472a;
            color: #9af0b6;
            font-size: 11px;
            font-weight: 800;
        }

        .detail {
            margin-top: 12px;
            color: #ddd;
            font-size: 13px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .amount {
            margin-top: 14px;
            padding-top: 13px;
            border-top: 1px solid #3a3a3a;
            color: #ffd329;
            font-size: 18px;
            font-weight: 900;
        }

        .notice {
            color: #ddd;
            font-size: 13px;
            line-height: 1.7;
        }

        .notice.error {
            border-color: #8a3939;
            color: #ffc1c1;
        }

        .empty { text-align: center; padding: 30px 15px; }
        .empty-icon { font-size: 38px; margin-bottom: 10px; }
        .muted { color: #aaa; font-size: 12px; }

        @@media (max-width: 360px) {
            .card { padding: 12px; }
        }
    </style>
</head>

<body>
<main class="container">
    <header class="header">
        <div class="brand">QAMISHLO DELIVERY</div>
        <div class="subtitle">Daily report and delivered order history</div>
        <div class="subtitle">Worker: @Model.WorkerName</div>
        <a class="back" href="/">← Back to dashboard</a>
    </header>

    <h2>Today's Report</h2>

    <section class="stats">
        <div class="card">
            <div class="label">Delivered today</div>
            <div class="value">@Model.DeliveredToday</div>
        </div>

        <div class="card">
            <div class="label">Today's total</div>
            <div class="value">@Model.TotalAmountToday.ToString("N0")</div>
            <div class="muted">IQD</div>
        </div>

        <div class="card">
            <div class="label">Average per delivered order</div>
            <div class="value">@Model.AverageOrderValue.ToString("N0")</div>
            <div class="muted">IQD — based on today's API totals</div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="notice error" style="margin-top:14px">
            @Model.ErrorMessage
        </div>
    }

    <h2>Delivered Orders</h2>

    @if (!Model.OrdersLoaded)
    {
        <div class="notice">
            The delivered-order list could not be confirmed from the current API response.
            Check the API response before relying on this history.
        </div>
    }
    else if (Model.DeliveredOrders.Count == 0)
    {
        <div class="order empty">
            <div class="empty-icon">📦</div>
            <strong>No delivered orders were returned</strong>
            <p class="muted">
                This can mean there are no delivered orders, or the current API
                endpoint returns active orders only.
            </p>
        </div>
    }
    else
    {
        foreach (var order in Model.DeliveredOrders)
        {
            <article class="order">
                <div class="order-top">
                    <div class="order-id">Order #@order.OrderID</div>
                    <span class="badge">Delivered</span>
                </div>

                <div class="detail">
                    <strong>Customer:</strong> @order.CustomerName
                </div>

                <div class="detail">
                    <strong>Phone:</strong>
                    @(string.IsNullOrWhiteSpace(order.CustomerPhone)
                        ? "Not provided"
                        : order.CustomerPhone)
                </div>

                <div class="detail">
                    <strong>Order date:</strong>
                    @order.OrderDate.ToString("yyyy-MM-dd HH:mm")
                </div>

                <div class="detail">
                    <strong>Address:</strong>
                    @(string.IsNullOrWhiteSpace(order.DeliveryAddress)
                        ? "Not provided"
                        : order.DeliveryAddress)
                </div>

                <div class="amount">
                    @order.TotalAmount.ToString("N0") IQD
                </div>
            </article>
        }
    }
</main>
</body>
</html>