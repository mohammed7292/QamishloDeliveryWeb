@page
@model QamishloDeliveryWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Qamishlo Delivery";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#14110F" />
    <meta name="description" content="Qamishlo Fast Food delivery worker application" />

    <link rel="manifest" href="/manifest.json" />

    <title>Qamishlo Delivery</title>

    <style>
        * { box-sizing:border-box; }
        :root { color-scheme:dark; --orange:#F37A1F; --bg:#14110F; --surface:rgba(37,32,29,.82); --muted:#9E9690; --line:rgba(255,255,255,.12); }
        body { margin:0; min-height:100vh; min-height:100dvh; display:flex; align-items:center; justify-content:center; padding:22px; font-family:Inter,Segoe UI,Arial,sans-serif; color:#fff; background:radial-gradient(ellipse at 16% 0%,rgba(74,40,16,.6),transparent 45%),radial-gradient(ellipse at 100% 80%,rgba(243,122,31,.12),transparent 42%),var(--bg); }
        .login-container { width:100%; max-width:420px; padding:30px 25px; border:1px solid var(--line); border-radius:28px; background:var(--surface); box-shadow:0 25px 70px rgba(0,0,0,.45),inset 0 1px rgba(255,255,255,.05); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); }
        .brand { text-align:center; margin-bottom:29px; }
        .logo { width:78px; height:78px; display:grid; place-items:center; margin:0 auto 17px; border:1px solid rgba(255,255,255,.2); border-radius:24px; background:linear-gradient(135deg,#FF9A43,var(--orange)); color:#20140C; font-size:25px; font-weight:950; box-shadow:0 10px 32px rgba(243,122,31,.27); }
        .brand h1 { margin:0; font-size:26px; letter-spacing:.5px; }
        .brand h1 span { color:var(--orange); }
        .subtitle { margin:10px 0 0; color:var(--muted); font-size:13px; }
        .welcome { margin-bottom:22px; }
        .welcome h2 { margin:0 0 7px; font-size:22px; }
        .welcome p { margin:0; color:var(--muted); font-size:13px; line-height:1.6; }
        .input-group { margin-bottom:18px; }
        .input-group label { display:block; margin-bottom:9px; color:#F1E8E2; font-size:13px; font-weight:800; }
        .input-group input { display:block; width:100%; min-height:52px; padding:14px; border:1px solid var(--line); border-radius:14px; outline:none; background:rgba(0,0,0,.22); color:#fff; font-size:16px; transition:border-color .2s,box-shadow .2s; }
        .input-group input:focus { border-color:var(--orange); box-shadow:0 0 0 3px rgba(243,122,31,.16); }
        .login-button { width:100%; min-height:54px; margin-top:7px; border:0; border-radius:15px; background:linear-gradient(100deg,#F37A1F,#FF9B3D); color:#20140C; font-size:16px; font-weight:950; cursor:pointer; box-shadow:0 10px 25px rgba(243,122,31,.18); }
        .login-button:active { transform:scale(.99); }
        .error-message { margin-top:17px; padding:13px; border:1px solid rgba(240,108,93,.42); border-radius:13px; background:rgba(108,35,29,.22); color:#FFB6AD; text-align:center; font-size:13px; line-height:1.55; overflow-wrap:anywhere; }
        .footer { margin-top:25px; color:#77706A; text-align:center; font-size:12px; }
        .footer strong { color:var(--orange); }
        .install-button { display:none; width:100%; margin-top:12px; padding:12px; border:1px solid var(--line); border-radius:12px; background:rgba(255,255,255,.07); color:#FFB879; font-size:14px; font-weight:bold; cursor:pointer; }
        @@media(max-width:380px) { body { padding:14px; } .login-container { padding:25px 18px; } .brand h1 { font-size:23px; } }
    </style>

    <style>
        .language-toggle { position:fixed; z-index:2000; top:calc(12px + env(safe-area-inset-top)); right:14px; min-width:86px; min-height:40px; padding:8px 13px; border:1px solid rgba(255,255,255,.2); border-radius:24px; background:rgba(37,32,29,.94); color:#FFB879; font:800 12px Inter,Segoe UI,Arial,sans-serif; box-shadow:0 8px 24px rgba(0,0,0,.3); backdrop-filter:blur(14px); cursor:pointer; }
        html[dir="rtl"] .language-toggle { right:auto; left:14px; }
        html[dir="rtl"] body { font-family:Tahoma,Segoe UI,Arial,sans-serif; }
    </style>
</head>

<body>
    <main class="login-container">
        <header class="brand">
            <div class="logo" aria-label="Qamishlo logo">QF</div>
            <h1>QAMISHLO <span>DELIVERY</span></h1>
            <p class="subtitle">Fast • Reliable • Professional</p>
        </header>

        <section class="welcome">
            <h2>Welcome back 👋</h2>
            <p>Sign in to manage your assigned deliveries.</p>
        </section>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="input-group">
                <label for="Username">Username</label>
                <input
                    id="Username"
                    name="Username"
                    type="text"
                    value="@Model.Username"
                    placeholder="Enter your username"
                    autocomplete="username"
                    autocapitalize="none"
                    spellcheck="false"
                    required />
            </div>

            <div class="input-group">
                <label for="Password">Password</label>
                <input
                    id="Password"
                    name="Password"
                    type="password"
                    placeholder="Enter your password"
                    autocomplete="current-password"
                    required />
            </div>

            <button type="submit" class="login-button">
                Sign In
            </button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <button id="installButton" class="install-button" type="button">
            Install Qamishlo Delivery
        </button>

        <footer class="footer">
            Powered by <strong>Qamishlo Fast Food</strong>
        </footer>
    </main>

    <script>
        // Register the PWA service worker.
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", async () => {
                try {
                    await navigator.serviceWorker.register(
                        "/service-worker.js",
                        { scope: "/" }
                    );
                } catch (error) {
                    console.error("Service worker registration failed:", error);
                }
            });
        }

        // Show the install button when the browser supports installation.
        let installPrompt = null;
        const installButton = document.getElementById("installButton");

        window.addEventListener("beforeinstallprompt", event => {
            event.preventDefault();
            installPrompt = event;
            installButton.style.display = "block";
        });

        installButton.addEventListener("click", async () => {
            if (!installPrompt) {
                alert("Use your browser menu and choose Add to Home screen or Install app.");
                return;
            }

            installPrompt.prompt();
            await installPrompt.userChoice;
            installPrompt = null;
            installButton.style.display = "none";
        });

        window.addEventListener("appinstalled", () => {
            installPrompt = null;
            installButton.style.display = "none";
        });
    </script>
    <script src="/js/language.js?v=1"></script>
</body>
</html>