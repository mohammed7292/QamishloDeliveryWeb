@page
@model QamishloDeliveryWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Qamishlo Delivery";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#E77B12" />
    <meta name="description" content="Qamishlo Fast Food delivery worker application" />

    <link rel="manifest" href="/manifest.json" />

    <title>Qamishlo Delivery</title>

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            color-scheme: dark;
            --orange: #E77B12;
            --yellow: #FFD329;
            --background: #101010;
            --surface: #1B1B1B;
            --muted: #A4A4A4;
        }

        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            font-family: Arial, Helvetica, sans-serif;
            color: white;
            background:
                radial-gradient(ellipse at top, #38210E 0%, transparent 48%),
                var(--background);
        }

        .login-container {
            width: 100%;
            max-width: 410px;
            padding: 30px 24px;
            background: linear-gradient(145deg, #222, #171717);
            border: 1px solid #37312A;
            border-radius: 26px;
            box-shadow: 0 24px 70px #0009;
        }

        .brand {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo {
            width: 78px;
            height: 78px;
            display: grid;
            place-items: center;
            margin: 0 auto 17px;
            border-radius: 23px;
            background: linear-gradient(135deg, var(--orange), var(--yellow));
            color: #17120A;
            font-size: 25px;
            font-weight: 900;
            box-shadow: 0 9px 28px #E77B1238;
        }

        .brand h1 {
            margin: 0;
            font-size: 27px;
            letter-spacing: .5px;
        }

        .brand h1 span {
            color: var(--yellow);
        }

        .subtitle {
            margin: 10px 0 0;
            color: var(--muted);
            font-size: 14px;
        }

        .welcome {
            margin-bottom: 22px;
        }

        .welcome h2 {
            margin: 0 0 7px;
            font-size: 21px;
        }

        .welcome p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.6;
        }

        .input-group {
            margin-bottom: 18px;
        }

        .input-group label {
            display: block;
            margin-bottom: 9px;
            color: #EAEAEA;
            font-size: 14px;
            font-weight: 600;
        }

        .input-group input {
            display: block;
            width: 100%;
            min-height: 51px;
            padding: 14px;
            border: 1px solid #3A3A3A;
            border-radius: 13px;
            outline: none;
            background: #111;
            color: white;
            font-size: 16px;
            transition: border-color .2s, box-shadow .2s;
        }

        .input-group input:focus {
            border-color: var(--orange);
            box-shadow: 0 0 0 3px #E77B1220;
        }

        .login-button {
            width: 100%;
            min-height: 53px;
            margin-top: 7px;
            border: none;
            border-radius: 14px;
            background: linear-gradient(100deg, var(--orange), var(--yellow));
            color: #211609;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
        }

        .login-button:active {
            transform: scale(.99);
        }

        .error-message {
            margin-top: 17px;
            padding: 13px;
            border: 1px solid #743737;
            border-radius: 12px;
            background: #381D1D;
            color: #FFAAAA;
            text-align: center;
            font-size: 14px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .footer {
            margin-top: 25px;
            color: #777;
            text-align: center;
            font-size: 12px;
        }

        .footer strong {
            color: var(--orange);
        }

        .install-button {
            display: none;
            width: 100%;
            margin-top: 12px;
            padding: 12px;
            border: 1px solid #51402A;
            border-radius: 12px;
            background: #29231C;
            color: var(--yellow);
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
        }

        @@media (max-width: 380px) {
            body {
                padding: 14px;
            }

            .login-container {
                padding: 25px 18px;
            }

            .brand h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>
    <main class="login-container">
        <header class="brand">
            <div class="logo" aria-label="Qamishlo logo">QF</div>
            <h1>QAMISHLO <span>DELIVERY</span></h1>
            <p class="subtitle">Fast • Reliable • Professional</p>
        </header>

        <section class="welcome">
            <h2>Welcome back 👋</h2>
            <p>Sign in to manage your assigned deliveries.</p>
        </section>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="input-group">
                <label for="Username">Username</label>
                <input
                    id="Username"
                    name="Username"
                    type="text"
                    value="@Model.Username"
                    placeholder="Enter your username"
                    autocomplete="username"
                    autocapitalize="none"
                    spellcheck="false"
                    required />
            </div>

            <div class="input-group">
                <label for="Password">Password</label>
                <input
                    id="Password"
                    name="Password"
                    type="password"
                    placeholder="Enter your password"
                    autocomplete="current-password"
                    required />
            </div>

            <button type="submit" class="login-button">
                Sign In
            </button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-message" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <button id="installButton" class="install-button" type="button">
            Install Qamishlo Delivery
        </button>

        <footer class="footer">
            Powered by <strong>Qamishlo Fast Food</strong>
        </footer>
    </main>

    <script>
        // Register the PWA service worker.
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", async () => {
                try {
                    await navigator.serviceWorker.register(
                        "/service-worker.js",
                        { scope: "/" }
                    );
                } catch (error) {
                    console.error("Service worker registration failed:", error);
                }
            });
        }

        // Show the install button when the browser supports installation.
        let installPrompt = null;
        const installButton = document.getElementById("installButton");

        window.addEventListener("beforeinstallprompt", event => {
            event.preventDefault();
            installPrompt = event;
            installButton.style.display = "block";
        });

        installButton.addEventListener("click", async () => {
            if (!installPrompt) {
                alert("Use your browser menu and choose Add to Home screen or Install app.");
                return;
            }

            installPrompt.prompt();
            await installPrompt.userChoice;
            installPrompt = null;
            installButton.style.display = "none";
        });

        window.addEventListener("appinstalled", () => {
            installPrompt = null;
            installButton.style.display = "none";
        });
    </script>
</body>
</html>