@page
@model QamishloDeliveryWeb.Pages.ReportsModel
@{
    Layout = null;
    ViewData["Title"] = "Delivery Reports";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14110F" />
    <link rel="manifest" href="/manifest.json" />
    <title>Delivery Reports - Qamishlo</title>

    <style>
        :root { color-scheme:dark; --bg:#14110F; --surface:rgba(37,32,29,.78); --line:rgba(255,255,255,.12); --orange:#F37A1F; --muted:#9E9690; }
        * { box-sizing:border-box; }
        body { margin:0; min-height:100vh; padding:18px 13px calc(35px + env(safe-area-inset-bottom)); color:#fff; font-family:Inter,Segoe UI,Arial,sans-serif; background:radial-gradient(ellipse at 10% 0%,rgba(74,40,16,.55),transparent 44%),radial-gradient(ellipse at 100% 12%,rgba(243,122,31,.13),transparent 35%),#14110F; background-attachment:fixed; }
        .container { width:100%; max-width:760px; margin:auto; }
        .header { position:relative; overflow:hidden; isolation:isolate; padding:24px; margin-bottom:22px; border:1px solid var(--line); border-radius:27px; color:#fff; background:linear-gradient(135deg,rgba(53,43,36,.94),rgba(28,25,23,.82)); box-shadow:0 18px 50px rgba(0,0,0,.28),inset 0 1px rgba(255,255,255,.06); backdrop-filter:blur(18px); }
        .header:after { content:"🛵"; position:absolute; z-index:-1; right:14px; bottom:5px; font-size:82px; opacity:.13; }
        .brand { color:#fff; font-size:19px; font-weight:950; letter-spacing:.5px; }
        .subtitle { margin-top:8px; color:var(--muted); font-size:13px; line-height:1.55; }
        .back { display:inline-flex; align-items:center; margin-top:19px; padding:10px 14px; border:1px solid var(--line); border-radius:30px; background:rgba(255,255,255,.07); color:#FFB879; font-size:13px; font-weight:850; text-decoration:none; }
        h2 { margin:25px 2px 13px; font-size:22px; font-weight:900; letter-spacing:-.3px; }
        .stats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:11px; }
        .card,.order,.notice { min-width:0; padding:18px; border:1px solid var(--line); border-radius:21px; background:var(--surface); box-shadow:0 12px 30px rgba(0,0,0,.17),inset 0 1px rgba(255,255,255,.04); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); }
        .label { color:var(--muted); font-size:12px; line-height:1.5; }
        .value { margin-top:8px; color:#FF9A43; font-size:clamp(22px,5vw,30px); font-weight:950; overflow-wrap:anywhere; }
        .order { margin-bottom:13px; }
        .order-top { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; padding-bottom:13px; border-bottom:1px solid rgba(255,255,255,.09); }
        .order-id { color:#fff; font-size:20px; font-weight:950; }
        .badge { padding:7px 11px; border:1px solid rgba(57,185,120,.35); border-radius:20px; background:rgba(38,139,83,.16); color:#9FE8BD; font-size:11px; font-weight:850; }
        .detail { margin-top:12px; color:#D5CCC5; font-size:13px; line-height:1.7; overflow-wrap:anywhere; }
        .detail strong { color:#fff; }
        .amount { margin-top:15px; padding-top:13px; border-top:1px solid rgba(255,255,255,.09); color:#FF9A43; font-size:19px; font-weight:950; }
        .notice { margin-top:14px; color:#E4DAD2; font-size:13px; line-height:1.75; }
        .notice.error { border-color:rgba(240,108,93,.42); background:rgba(108,35,29,.22); color:#FFB6AD; }
        .empty { text-align:center; padding:32px 15px; }
        .empty-icon { font-size:38px; margin-bottom:10px; }
        .muted { color:var(--muted); font-size:12px; line-height:1.6; }
        @@media(max-width:360px) { body { padding-left:10px; padding-right:10px; } .card,.order { padding:14px; } .header { padding:19px; } }
    </style>

    <style>
        .language-toggle { position:fixed; z-index:2000; top:calc(12px + env(safe-area-inset-top)); right:14px; min-width:86px; min-height:40px; padding:8px 13px; border:1px solid rgba(255,255,255,.2); border-radius:24px; background:rgba(37,32,29,.94); color:#FFB879; font:800 12px Inter,Segoe UI,Arial,sans-serif; box-shadow:0 8px 24px rgba(0,0,0,.3); backdrop-filter:blur(14px); cursor:pointer; }
        html[dir="rtl"] .language-toggle { right:auto; left:14px; }
        html[dir="rtl"] body { font-family:Tahoma,Segoe UI,Arial,sans-serif; }
    </style>
</head>

<body>
<main class="container">
    <header class="header">
        <div class="brand">QAMISHLO DELIVERY</div>
        <div class="subtitle">Daily report and delivered order history</div>
        <div class="subtitle">Worker: @Model.WorkerName</div>
        <a class="back" href="/">← Back to dashboard</a>
    </header>

    <h2>Today's Report</h2>

    <section class="stats">
        <div class="card">
            <div class="label">Delivered today</div>
            <div class="value">@Model.DeliveredToday</div>
        </div>

        <div class="card">
            <div class="label">Today's total</div>
            <div class="value">@Model.TotalAmountToday.ToString("N0")</div>
            <div class="muted">IQD</div>
        </div>

        <div class="card">
            <div class="label">Average per delivered order</div>
            <div class="value">@Model.AverageOrderValue.ToString("N0")</div>
            <div class="muted">IQD — based on today's API totals</div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="notice error" style="margin-top:14px">
            @Model.ErrorMessage
        </div>
    }

    <h2>Delivered Orders</h2>

    @if (!Model.OrdersLoaded)
    {
        <div class="notice">
            The delivered-order list could not be confirmed from the current API response.
            Check the API response before relying on this history.
        </div>
    }
    else if (Model.DeliveredOrders.Count == 0)
    {
        <div class="order empty">
            <div class="empty-icon">📦</div>
            <strong>No delivered orders were returned</strong>
            <p class="muted">
                This can mean there are no delivered orders, or the current API
                endpoint returns active orders only.
            </p>
        </div>
    }
    else
    {
        foreach (var order in Model.DeliveredOrders)
        {
            <article class="order">
                <div class="order-top">
                    <div class="order-id">Order #@order.OrderID</div>
                    <span class="badge">Delivered</span>
                </div>

                <div class="detail">
                    <strong>Customer:</strong> @order.CustomerName
                </div>

                <div class="detail">
                    <strong>Phone:</strong>
                    @(string.IsNullOrWhiteSpace(order.CustomerPhone)
                        ? "Not provided"
                        : order.CustomerPhone)
                </div>

                <div class="detail">
                    <strong>Order date:</strong>
                    @order.OrderDate.ToString("yyyy-MM-dd HH:mm")
                </div>

                <div class="detail">
                    <strong>Address:</strong>
                    @(string.IsNullOrWhiteSpace(order.DeliveryAddress)
                        ? "Not provided"
                        : order.DeliveryAddress)
                </div>

                <div class="amount">
                    @order.TotalAmount.ToString("N0") IQD
                </div>
            </article>
        }
    }
</main>
    <script src="/js/language.js?v=1"></script>
</body>
</html>